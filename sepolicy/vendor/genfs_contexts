# OpenVFD status icons (led_on, led_off), written by OpenVFDService
genfscon sysfs /devices/platform/openvfd/leds/openvfd    u:object_r:sysfs_leds:s0

# eMMC, for init setting discard_max_bytes of userdata
genfscon sysfs /devices/platform/ffe07000.emmc/mmc_host/mmc0/mmc0:0001/block/mmcblk0/queue/discard_max_bytes    u:object_r:sysfs_mmc_host:s0

# Wakeup sources, read by system_suspend
genfscon sysfs /devices/platform/ff3f0000.ethernet/wakeup    u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/ff63003c.bl40/wakeup    u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/ff80023c.aocec/wakeup    u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/ff8000a8.rtc/rtc/rtc0/alarmtimer.1.auto/wakeup    u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/ff8000a8.rtc/wakeup    u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/ff808040.ir/wakeup    u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/ffe03000.sdio/mmc_host/mmc2/mmc2:0001/mmc2:0001:1/wakeup    u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/ff660000.audiobus/ff660000.audiobus:vad/wakeup    u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/wifi/wakeup    u:object_r:sysfs_wakeup:s0
