type openvfd_clock, domain;
type openvfd_clock_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(openvfd_clock)

allow openvfd_clock vendor_shell_exec:file rx_file_perms;
allow openvfd_clock vendor_toolbox_exec:file rx_file_perms;

# Display the time through the OpenVFD sysfs attributes
allow openvfd_clock sysfs_openvfd:dir r_dir_perms;
allow openvfd_clock sysfs_openvfd:file w_file_perms;
