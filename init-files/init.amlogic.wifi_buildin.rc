on post-fs-data
    # The stock multi-wifi HAL (libwifi-hal-common-ext.so) reads the chip
    # name from wid_fp. It only writes it while loading the driver itself,
    # which it skips because the module is already loaded here.
    mkdir /data/vendor/wifi 0770 wifi wifi
    write /data/vendor/wifi/wid_fp mtk7668s
    chown wifi wifi /data/vendor/wifi/wid_fp
    chmod 0660 /data/vendor/wifi/wid_fp
    restorecon /data/vendor/wifi/wid_fp

on boot
    # Unlike dhd, the MT7668 driver does not use the Amlogic power hooks:
    # power the SDIO chip up and rescan the bus before loading it.
    write /sys/class/aml_wifi/power 1
    insmod /vendor/lib/modules/wlan_mt76x8_sdio.ko
    # BT shares the chip core with Wi-Fi: btmtksdio must start only after
    # the Wi-Fi probe has finished (insmod above is synchronous), otherwise
    # its WMT setup races the Wi-Fi patch download and both time out.
    # insmod does not resolve dependencies, and bluetooth.ko lives on
    # system_dlkm, which vendor_modprobe may not load from.
    exec u:r:modprobe:s0 -- /system/bin/modprobe -a -d /system_dlkm/lib/modules bluetooth
    insmod /vendor/lib/modules/btmtksdio.ko
