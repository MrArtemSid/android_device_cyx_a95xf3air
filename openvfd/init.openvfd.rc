on boot
    insmod /vendor/lib/modules/openvfd.ko
    wait /dev/openvfd
    chown system system /dev/openvfd
    chmod 0660 /dev/openvfd
    start vendor.openvfd

# Shows the clock. The driver only keeps the display powered while
# /dev/openvfd is open, which the service does for as long as it runs.
service vendor.openvfd /vendor/bin/OpenVFDService
    class late_start
    user system
    group system
    disabled
