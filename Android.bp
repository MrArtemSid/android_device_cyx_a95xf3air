soong_namespace {}

// Stock Amlogic multi-wifi HAL (Android 9), dlopen()ed by the Wi-Fi HAL
// service through wifi/wifi_vendor_hal.xml. Installed under a different name,
// so the AOSP fallback libwifi-hal stays in place.
cc_prebuilt_library_shared {
    name: "libwifi-hal-amlogic",
    owner: "amlogic",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["proprietary/vendor/lib/libwifi-hal.so"],
            shared_libs: [
                "libbase",
                "libcutils",
                "liblog",
                "libnl",
                "libutils",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "32",
    check_elf_files: false,
    soc_specific: true,
}

// Detects the chip (SDIO 037a:7608 -> mtk7668s) for libwifi-hal-amlogic.
cc_prebuilt_library_shared {
    name: "libwifi-hal-common-ext",
    owner: "amlogic",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["proprietary/vendor/lib/libwifi-hal-common-ext.so"],
        },
    },
    // ifc_init/ifc_up come from the vendor variant of AOSP libnetutils.
    shared_libs: ["libnetutils"],
    compile_multilib: "32",
    check_elf_files: false,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libGLES_mali",
    owner: "amlogic",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: [
                "proprietary/vendor/lib/egl/libGLES_mali.so",
            ],
            shared_libs: [
                "android.hardware.graphics.allocator-V2-ndk",
                "libbinder_ndk",
                "libnativewindow",
                "libutils",
                "android.hardware.graphics.mapper@4.0",
                "libgralloctypes",
                "libhidlbase",
                "liblog",
                "libcutils",
                "libhardware",
                "android.hardware.graphics.common-V7-ndk",
                "libbase",
                "libdmabufheap",
                "libz",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "32",
    relative_install_path: "egl",
    prefer: true,
    soc_specific: true,
}

install_symlink {
    name: "vendor_lib_hw_vulkan_amlogic_so",
    soc_specific: true,
    installed_location: "lib/hw/vulkan.amlogic.so",
    symlink_target: "/vendor/lib/egl/libGLES_mali.so",
}
